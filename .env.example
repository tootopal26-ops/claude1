# ─────────────────────────────────────────────────────────────────────────────
# SOCIAL MEDIA BOOSTER — environment configuration
# Copy this file to ".env" (the web installer does this for you) and edit.
# NEVER commit ".env" and never put it inside a web-readable folder.
# ─────────────────────────────────────────────────────────────────────────────

# production | local   (local shows detailed errors and enables dev-only tools)
APP_ENV=production
APP_DEBUG=false

# Public URL of the site, no trailing slash. The scheme decides whether cookies
# are marked Secure, so use https:// in production.
APP_URL=https://example.com

# 32 random bytes, base64 encoded:  base64:xxxxxxxx...
# Generate with:  php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# This key encrypts API keys stored in the database and signs CSRF tokens.
# If you lose or change it, saved gateway/SMM keys must be re-entered.
APP_KEY=

# MySQL / MariaDB (create the database and user in cPanel → MySQL® Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Business time zone used for "today", daily reports and ad-spend days.
# Can also be changed later in Admin → Settings → Website.
APP_TIMEZONE=Asia/Kolkata

# Secret used to call the HTTP cron endpoint:  https://example.com/cron/run?key=...
# (Only needed if your host cannot run "php bin/cron.php" from cPanel Cron Jobs.)
CRON_KEY=

# ── Reverse proxy / CDN (leave empty on plain cPanel hosting) ───────────────
# Name of the header that carries the real visitor IP, e.g. CF-Connecting-IP
# (Cloudflare) or X-Forwarded-For. Only set this if ALL traffic comes through
# that proxy, otherwise visitors could spoof their IP and dodge rate limits.
TRUSTED_PROXY_HEADER=

# ── Safety switches ──────────────────────────────────────────────────────────
# Allow the payment/SMM API URLs to point at private or local addresses.
# Keep "false" in production (SSRF protection). "true" only for local mock servers.
ALLOW_PRIVATE_API_HOSTS=false
