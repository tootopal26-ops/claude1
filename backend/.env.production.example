APP_NAME="Mini Max"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE-ME.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=minimax
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Set to a real, freshly generated password before the first `php
# artisan db:seed --force`. The fallback in DatabaseSeeder
# ("change-me-now") must never reach a production database — change
# this value and rotate the admin account's password immediately if it
# ever did.
SEED_ADMIN_PASSWORD=

# Firebase (push notifications). Place the Admin SDK service account
# JSON at storage/app/firebase/service-account.json (gitignored) — see
# docs/firebase-setup.md. Leave FIREBASE_CREDENTIALS unset to use that
# default path, or point it elsewhere.
FIREBASE_CREDENTIALS=

# Alpha UPI / Lola Pay (deposit gateway). No sandbox — this provider is
# production-only, so these must be the real, rotated merchant
# credentials from the provider dashboard. Never commit real values —
# set them only here, directly on the deployed server.
ALPHA_UPI_BASE_URL=https://alphaupi.site/api
ALPHA_UPI_API_KEY=
ALPHA_UPI_API_SECRET=
ALPHA_UPI_WEBHOOK_SECRET=

# backup:run (see docs/backup-restore.md). Defaults to
# storage/app/backups and 14 days if left unset — override here to
# point at a dedicated backup volume/mount if the server has one.
# BACKUP_PATH=
# BACKUP_RETENTION_DAYS=

# Customer Support link (optional fallback; Admin > Customer Support
# overrides it). https:// or mailto: only.
# MINIMAX_SUPPORT_URL=

# Ads (Unity LevelPlay mediation with AdMob + Unity Ads) — see
# docs/ads-monetization.md. Everything is OFF by default; Admin >
# Ads & Monetization switches it on once the provider setup is done.
# The app key and ad unit IDs are public (they ship inside the app).
# The S2S private key is the secret LevelPlay signs reward callbacks
# with: set it ONLY here, never in the app, the Admin panel or git.
MINIMAX_ADS_ENABLED=false
MINIMAX_ADS_REWARDED_ENABLED=false
MINIMAX_ADS_TEST_MODE=true
LEVELPLAY_APP_KEY=
LEVELPLAY_S2S_PRIVATE_KEY=
# Local QA only. Refused in production whatever this says.
MINIMAX_ADS_ALLOW_SIMULATED_REWARDS=false
