# ─────────────────────────────────────────────────────────────────────────────
# SOCIAL MEDIA BOOSTER — public/.htaccess  (Apache / LiteSpeed, cPanel-ready)
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes -MultiViews
# index.php first; the others only matter when other sites share this web root (e.g. an old static site in a sub-folder).
DirectoryIndex index.php index.html index.htm

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dot-files (.env, .git, .htaccess …) even if they ended up here.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Only index.php may execute at the top of this folder, so a stray test script or an uploaded shell can never run.
    # Anchored to this folder on purpose: other PHP applications living in sub-folders of the same web root keep working.
    RewriteRule ^(?!index\.php$)[^/]+\.(?:php[0-9]?|phtml|phar)$ - [F,L,NC]

    # Pass the Authorization header through (some hosts strip it).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Real files and folders are served directly (assets, uploads) …
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # … everything else goes to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# ── security ────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Static files only: pages and API answers (index.php) already carry their own full set of security headers.
    <FilesMatch "\.(css|js|mjs|json|webmanifest|svg|png|jpe?g|gif|webp|ico|woff2?|txt|xml)$">
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>
    Header always unset X-Powered-By
</IfModule>

# ── performance ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    # Static files only. Pages, JSON and the dynamic /theme.css (all served by index.php) set their own Cache-Control.
    <FilesMatch "\.(css|js|svg|png|jpe?g|gif|webp|ico|woff2?)$">
        ExpiresActive On
        ExpiresByType image/svg+xml  "access plus 30 days"
        ExpiresByType image/webp     "access plus 30 days"
        ExpiresByType image/png      "access plus 30 days"
        ExpiresByType image/jpeg     "access plus 30 days"
        ExpiresByType image/x-icon   "access plus 30 days"
        ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
        ExpiresByType font/woff2     "access plus 1 year"
        # CSS/JS are versioned with ?v=<mtime> by the templates
        ExpiresByType text/css       "access plus 1 year"
        ExpiresByType application/javascript "access plus 1 year"
        ExpiresByType text/javascript "access plus 1 year"
    </FilesMatch>
</IfModule>

AddType font/woff2 .woff2
AddType application/javascript .js
AddType image/webp .webp
